{
  "manifest_version": 3,
  "name": "Video Downloader (yt-dlp)",
  "version": "1.0.0",
  "description": "Télécharge la vidéo de l'onglet actif (YouTube, Instagram, TikTok et de nombreux autres sites) via yt-dlp installé localement.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["nativeMessaging", "activeTab", "storage", "contextMenus", "notifications"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Télécharger la vidéo",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
