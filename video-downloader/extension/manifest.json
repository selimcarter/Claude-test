{
  "manifest_version": 3,
  "name": "Video Downloader (yt-dlp)",
  "version": "2.0.0",
  "description": "Télécharge la vidéo de l'onglet actif (YouTube, Instagram, TikTok et de nombreux autres sites) via yt-dlp installé localement.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "storage",
    "contextMenus",
    "notifications",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://*.tiktok.com/*",
        "https://*.instagram.com/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Télécharger la vidéo",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "download-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Télécharger la vidéo de l'onglet actif"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
